-- | BitSafe Decentralization challenge: M-of-N governed settlement (R-GOV-1/2).
--
-- Named controllers (LocalNet / Script fixtures):
--   Gov1, Gov2, Gov3  — BitSafe contribution-pool governors
-- Threshold (LocalNet demos):
--   threshold = 2     — 2-of-3 must approve before ExecuteGoverned or CancelGoverned
--
-- What the ledger enforces:
--   * Approvals are GovernorApproval contracts signed by the governor alone —
--     the operator cannot create one on a governor's behalf.
--   * A governed WorkflowAgreement can only settle via SettleGoverned, which
--     counts distinct signed approvals (plain Settle is refused).
--   * Any single governor can veto: the agreement is archived, nothing can settle.
--   * Every settle path checks the ProtocolCircuitBreaker (see Composition.daml).
module Governance where

import Composition
import DA.Set (Set)
import qualified DA.Set as Set

-- | Coordinates one governed agreement. Gives the governors a contract they can
-- act on (approve / veto); the threshold itself is enforced on the agreement.
template GovernedSettlement
  with
    operator : Party
    agreementCid : ContractId WorkflowAgreement
    settlementParties : Set Party
    governors : Set Party
    threshold : Int
    regulator : Party
  where
    signatory operator
    observer (Set.toList governors ++ Set.toList settlementParties)
    ensure
      threshold >= 1
      && threshold <= Set.size governors
      && Set.size governors >= 1

    -- | A governor signs an approval to settle. Controller is the governor
    -- alone, so only that governor can produce its approval.
    nonconsuming choice ApproveGoverned : ContractId GovernorApproval
      with
        governor : Party
      controller governor
      do
        assertMsg "not a named governor" (Set.member governor governors)
        create GovernorApproval with
          operator
          governor
          agreementCid
          action = ApproveSettlement

    -- | R-GOV-1: rejects unless >= threshold distinct governors signed approvals
    -- (checked by WorkflowAgreement.SettleGoverned). R-GOV-2: settles at threshold.
    choice ExecuteGoverned : ContractId SettlementReceipt
      with
        allocationCids : [ContractId LegAllocation]
        approvalCids : [ContractId GovernorApproval]
        breakerCid : ContractId ProtocolCircuitBreaker
      controller operator, Set.toList settlementParties
      do
        exercise agreementCid SettleGoverned with
          regulator
          allocationCids
          approvalCids
          breakerCid

    -- | A governor signs an approval to cancel (same M-of-N set).
    nonconsuming choice ApproveCancelGoverned : ContractId GovernorApproval
      with
        governor : Party
      controller governor
      do
        assertMsg "not a named governor" (Set.member governor governors)
        create GovernorApproval with
          operator
          governor
          agreementCid
          action = ApproveCancel

    -- | Cancel needs >= threshold distinct governor-signed cancel approvals.
    choice CancelGoverned : ()
      with
        reason : Text
        approvalCids : [ContractId GovernorApproval]
      controller operator
      do
        agr <- fetch agreementCid
        case agr.governance of
          None -> abort "agreement is not governed"
          Some terms -> do
            n <- countApprovals agreementCid terms ApproveCancel approvalCids
            assertMsg
              ("below threshold: " <> show n <> "/" <> show terms.threshold <>
                " cancel approvals — governed cancel must not execute")
              (n >= terms.threshold)
        exercise agreementCid CancelAgreement with reason

    -- | Emergency veto: any single named governor stops the deal. The agreement
    -- is archived, so neither the parties nor the operator can still settle it.
    choice EmergencyVeto : ()
      with
        governor : Party
        reason : Text
      controller governor
      do
        assertMsg "not a named governor" (Set.member governor governors)
        exercise agreementCid CancelAgreement with
          reason = "Emergency veto by governor: " <> reason

-- | Factory: wrap a governed agreement in a GovernedSettlement coordinator.
-- Governors and threshold come from the agreement itself (agreed at proposal).
template GovernanceFactory
  with
    operator : Party
  where
    signatory operator

    nonconsuming choice OpenGovernedSettlement : ContractId GovernedSettlement
      with
        agreementCid : ContractId WorkflowAgreement
        regulator : Party
      controller operator
      do
        agr <- fetch agreementCid
        case agr.governance of
          None -> abort "agreement is not governed: nothing to open"
          Some terms ->
            create GovernedSettlement with
              operator
              agreementCid
              settlementParties = agr.parties
              governors = Set.fromList terms.governors
              threshold = terms.threshold
              regulator
