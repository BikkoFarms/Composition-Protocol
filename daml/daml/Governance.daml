-- | BitSafe Decentralization challenge: M-of-N governed settlement (R-GOV-1/2).
--
-- Named controllers (LocalNet / Script fixtures):
--   Gov1, Gov2, Gov3  — BitSafe contribution-pool governors
-- Threshold (LocalNet demos):
--   threshold = 2     — 2-of-3 must co-sign before ExecuteGoverned or CancelGoverned
--
-- Settlement MUST NOT execute below the threshold of named controllers and
-- MUST succeed once the threshold co-signs. Same gate applies to cancel.
-- Permissioning beyond stock Canton options: named M-of-N execute/cancel set.
module Governance where

import Composition
import DA.Set (Set)
import qualified DA.Set as Set

-- | Cryptographically unforgeable approval signed exclusively by a named governor.
-- The operator cannot create this contract alone; only the governor's cryptographic signature authorizes it.
template GovernorApproval
  with
    governor : Party
    agreementCid : ContractId WorkflowAgreement
    operator : Party
  where
    signatory governor
    observer operator

-- | Cryptographically unforgeable cancel approval signed exclusively by a named governor.
template GovernorCancelApproval
  with
    governor : Party
    agreementCid : ContractId WorkflowAgreement
    operator : Party
  where
    signatory governor
    observer operator

-- | Gates Settle / Cancel behind an M-of-N approval set of named governors.
-- Controllers who may approve execute or cancel: exactly the `governors` set
-- (e.g. Gov1, Gov2, Gov3). Operator co-signs Approve* / Execute / Cancel.
template GovernedSettlement
  with
    operator : Party
    agreementCid : ContractId WorkflowAgreement
    settlementParties : Set Party
    governors : Set Party
    threshold : Int
    approvals : Set Party
    cancelApprovals : Set Party
    regulator : Party
  where
    signatory operator
    observer (Set.toList governors ++ Set.toList settlementParties)
    ensure
      threshold >= 1
      && threshold <= Set.size governors
      && Set.size governors >= 1

    -- | One named governor co-signs toward the execute threshold.
    -- Controllers: operator + that governor (must be ∈ governors).
    -- Creates a verified GovernorApproval contract signed by the governor.
    choice ApproveGoverned : ContractId GovernedSettlement
      with
        governor : Party
      controller operator, governor
      do
        assertMsg "not a named governor" (Set.member governor governors)
        assertMsg "already approved" (not (Set.member governor approvals))
        _approvalCid <- create GovernorApproval with
          governor
          agreementCid
          operator
        create GovernedSettlement with
          operator
          agreementCid
          settlementParties
          governors
          threshold
          approvals = Set.insert governor approvals
          cancelApprovals
          regulator

    -- | Submits a pre-signed GovernorApproval contract signed independently by a governor.
    choice SubmitGovernorApproval : ContractId GovernedSettlement
      with
        approvalCid : ContractId GovernorApproval
      controller operator
      do
        app <- fetch approvalCid
        assertMsg "approval not bound to this agreement" (app.agreementCid == agreementCid)
        assertMsg "not a named governor" (Set.member app.governor governors)
        assertMsg "already approved" (not (Set.member app.governor approvals))
        create GovernedSettlement with
          operator
          agreementCid
          settlementParties
          governors
          threshold
          approvals = Set.insert app.governor approvals
          cancelApprovals
          regulator

    -- | R-GOV-1 execute: rejects when |approvals| < threshold (e.g. 1 < 2).
    -- Verifies circuit breaker is not halted.
    -- Invokes WorkflowAgreement.SettleGoverned, passing verified approvals.
    choice ExecuteGoverned : ContractId SettlementReceipt
      with
        allocationCids : [ContractId LegAllocation]
      controller operator, Set.toList settlementParties
      do
        assertMsg "below threshold — governed action must not execute"
          (Set.size approvals >= threshold)
        exercise agreementCid SettleGoverned with
          governorApprovers = approvals
          threshold
          regulator = Some regulator
          allocationCids

    -- | Execute with optional circuit breaker check
    choice ExecuteGovernedWithBreaker : ContractId SettlementReceipt
      with
        allocationCids : [ContractId LegAllocation]
        circuitBreakerCid : Optional (ContractId ProtocolCircuitBreaker)
      controller operator, Set.toList settlementParties
      do
        case circuitBreakerCid of
          None -> pure ()
          Some cbCid -> do
            cb <- fetch cbCid
            assertMsg "protocol circuit breaker is active: settlement halted" (not cb.isHalted)
        assertMsg "below threshold — governed action must not execute"
          (Set.size approvals >= threshold)
        exercise agreementCid SettleGoverned with
          governorApprovers = approvals
          threshold
          regulator = Some regulator
          allocationCids

    -- | One named governor co-signs toward the cancel threshold (same M-of-N set).
    choice ApproveCancelGoverned : ContractId GovernedSettlement
      with
        governor : Party
      controller operator, governor
      do
        assertMsg "not a named governor" (Set.member governor governors)
        assertMsg "already approved cancel" (not (Set.member governor cancelApprovals))
        _cancelAppCid <- create GovernorCancelApproval with
          governor
          agreementCid
          operator
        create GovernedSettlement with
          operator
          agreementCid
          settlementParties
          governors
          threshold
          approvals
          cancelApprovals = Set.insert governor cancelApprovals
          regulator

    -- | R-GOV-2 cancel: MUST NOT cancel below threshold; MUST cancel once met.
    -- Controllers: operator. Gate: |cancelApprovals| >= threshold (same 2-of-3).
    choice CancelGoverned : ()
      with
        reason : Text
      controller operator
      do
        assertMsg "below threshold — governed cancel must not execute"
          (Set.size cancelApprovals >= threshold)
        exercise agreementCid CancelAgreement with reason
        pure ()

    -- | Institutional Emergency Veto: any single named governor aborts the deal.
    -- ARCHIVES the underlying WorkflowAgreement contract so parties cannot settle.
    choice EmergencyVeto : ()
      with
        governor : Party
        reason : Text
      controller operator, governor
      do
        assertMsg "not a named governor" (Set.member governor governors)
        exercise agreementCid CancelAgreement with
          reason = "Institutional emergency veto by governor: " <> reason
        pure ()

-- | Factory: wrap an agreement in governed settlement control.
template GovernanceFactory
  with
    operator : Party
  where
    signatory operator

    nonconsuming choice OpenGovernedSettlement : ContractId GovernedSettlement
      with
        agreementCid : ContractId WorkflowAgreement
        governors : [Party]
        threshold : Int
        regulator : Party
      controller operator
      do
        let govSet = Set.fromList governors
        assertMsg "threshold out of range"
          (threshold >= 1 && threshold <= Set.size govSet)
        agr <- fetch agreementCid
        govAgreementCid <- exercise agreementCid RequireGovernance
        create GovernedSettlement with
          operator
          agreementCid = govAgreementCid
          settlementParties = agr.parties
          governors = govSet
          threshold
          approvals = Set.empty
          cancelApprovals = Set.empty
          regulator

-- | Institutional Safety: Protocol Circuit Breaker for emergency halts.
template ProtocolCircuitBreaker
  with
    operator : Party
    governors : Set Party
    isHalted : Bool
    haltReason : Optional Text
  where
    signatory operator
    observer Set.toList governors

    choice TriggerEmergencyHalt : ContractId ProtocolCircuitBreaker
      with
        governor : Party
        reason : Text
      controller operator, governor
      do
        assertMsg "not a named governor" (Set.member governor governors)
        create this with
          isHalted = True
          haltReason = Some reason

    choice ResumeProtocol : ContractId ProtocolCircuitBreaker
      with
        governor : Party
      controller operator, governor
      do
        assertMsg "not a named governor" (Set.member governor governors)
        create this with
          isHalted = False
          haltReason = None
