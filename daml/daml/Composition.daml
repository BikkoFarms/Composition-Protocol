-- | Settleflow — reusable settlement-workflow package (Daml 3.x).
-- Contracts: ComposableWorkflow, WorkflowProposal, AcceptanceTracker,
--            WorkflowAgreement, LegAllocation, SettlementReceipt.
-- Lifecycle: Propose → Accept (tracker gates) → Allocate → Settle (atomic match) → Expire/Cancel.
-- Privacy: SettlementReceipt observers include regulator; leg payloads stay off-receipt.
module Composition where

import ComposableAsset
import DA.Foldable (forA_)
import DA.Set (Set)
import qualified DA.Set as Set

-- | One proposed transfer leg. Asset payloads live on disclosed ComposableAsset
-- contracts, not on the receipt the regulator observes.
-- Agreed terms locked here are the source of truth for allocation matching on Settle.
data LegSpec = LegSpec with
    legId : Text
    instrumentId : Text
    amount : Decimal
    provider : Party
    receiver : Party
    assetCid : ContractId ComposableAsset
    reference : Text   -- trade/leg reference that allocation must echo
    deadline : Time    -- allocation + settlement must complete by this instant
  deriving (Eq, Show)

data LegStatus = LegPending | LegSettled | LegFailed
  deriving (Eq, Show)

-- | Blinded leg metadata only — no assetCid / amount payload for regulators.
data LegSummary = LegSummary with
    legId : Text
    instrumentId : Text
    status : LegStatus
  deriving (Eq, Show)

-- | Posted pledge against one WorkflowAgreement leg. Consumed on successful Settle.
-- Allocator (provider) may WithdrawAllocation before settlement.
template LegAllocation
  with
    operator : Party
    agreementCid : ContractId WorkflowAgreement
    allocator : Party
    legId : Text
    instrumentId : Text
    amount : Decimal
    provider : Party
    receiver : Party
    assetCid : ContractId ComposableAsset
    reference : Text
    deadline : Time
  where
    signatory allocator, operator
    observer [provider, receiver]
    ensure
      allocator == provider
      && amount > 0.0

    choice WithdrawAllocation : ()
      controller allocator
      do
        pure ()

-- | Package entry point: reusable factory for structured settlement workflows.
-- Signatory: operator. Nonconsuming Propose creates a WorkflowProposal.
template ComposableWorkflow
  with
    operator : Party
  where
    signatory operator

    nonconsuming choice Propose : ContractId WorkflowProposal
      with
        proposer : Party
        counterparties : [Party]
        legs : [LegSpec]
        description : Text
        expiresAt : Time
      controller operator, proposer
      do
        assertMsg "at least two legs required" (length legs >= 2)
        assertMsg "at least one counterparty required" (length counterparties >= 1)
        create WorkflowProposal with
          operator
          proposer
          counterparties
          legs
          description
          expiresAt

-- | Proposed multi-leg deal. Accept builds/fills AcceptanceTracker;
-- Reject / Expire / Cancel resolve stalled workflows cleanly.
template WorkflowProposal
  with
    operator : Party
    proposer : Party
    counterparties : [Party]
    legs : [LegSpec]
    description : Text
    expiresAt : Time
  where
    signatory proposer, operator
    observer counterparties
    ensure
      length legs >= 2
      && length counterparties >= 1

    choice RejectProposal : ()
      with
        reason : Text
        rejector : Party
      controller rejector
      do
        assertMsg "rejector must be a counterparty" (elem rejector counterparties)
        pure ()

    choice CancelProposal : ()
      controller proposer
      do
        pure ()

    choice ExpireProposal : ()
      controller operator
      do
        now <- getTime
        assertMsg "proposal has not expired" (now >= expiresAt)
        pure ()

    -- | First accept creates the tracker; subsequent accepts RecordAcceptance.
    -- Settlement cannot proceed until AcceptanceTracker finalizes.
    nonconsuming choice AcceptProposal : ContractId AcceptanceTracker
      with
        acceptor : Party
        trackerCid : Optional (ContractId AcceptanceTracker)
      controller operator, acceptor
      do
        assertMsg "acceptor must be a counterparty" (elem acceptor counterparties)
        now <- getTime
        assertMsg "proposal has expired" (now < expiresAt)
        case trackerCid of
          None ->
            create AcceptanceTracker with
              operator
              proposalCid = self
              proposer
              required = Set.fromList counterparties
              accepted = Set.fromList [acceptor]
              legs
              description
          Some cid -> do
            exercise cid RecordAcceptance with acceptor

-- | Tracks which counterparties have accepted; gates FinalizeAgreement / Settle.
template AcceptanceTracker
  with
    operator : Party
    proposalCid : ContractId WorkflowProposal
    proposer : Party
    required : Set Party
    accepted : Set Party
    legs : [LegSpec]
    description : Text
  where
    signatory operator
    observer Set.toList required
    ensure not (Set.null required)

    choice RecordAcceptance : ContractId AcceptanceTracker
      with
        acceptor : Party
      controller operator, acceptor
      do
        assertMsg "not a required party" (Set.member acceptor required)
        create AcceptanceTracker with
          operator
          proposalCid
          proposer
          required
          accepted = Set.insert acceptor accepted
          legs
          description

    -- | Only when every required party has accepted may the agreement be formed.
    -- Validates that the underlying proposal is still active and has not expired/been cancelled.
    choice FinalizeAgreement : ContractId WorkflowAgreement
      controller operator
      do
        assertMsg "not all counterparties have accepted"
          (Set.isSubsetOf required accepted)
        proposal <- fetch proposalCid
        now <- getTime
        assertMsg "underlying proposal has expired" (now < proposal.expiresAt)
        archive proposalCid
        create WorkflowAgreement with
          operator
          parties = Set.insert proposer required
          legs
          description
          acceptedBy = accepted
          governanceRequired = False

-- | Match one posted LegAllocation against one agreed LegSpec.
-- ANY failed assert aborts the enclosing Settle transaction (no partial commit).
-- Fields checked (in order): legId → parties → amount → instrumentId →
-- reference → deadline (agreed + wall-clock) → assetCid → live asset view.
matchAllocationToLeg : Time -> LegSpec -> LegAllocation -> Update ()
matchAllocationToLeg now leg alloc = do
    -- Presence / identity: allocation must address this exact leg.
    assertMsg
      ("allocation match failed: legId mismatch (agreed=" <> leg.legId <>
        ", allocated=" <> alloc.legId <> ")")
      (alloc.legId == leg.legId)

    -- Parties: provider and receiver must equal the trade's agreed parties.
    assertMsg
      ("allocation match failed: provider party mismatch on leg " <> leg.legId)
      (alloc.provider == leg.provider)
    assertMsg
      ("allocation match failed: receiver party mismatch on leg " <> leg.legId)
      (alloc.receiver == leg.receiver)
    assertMsg
      ("allocation match failed: allocator must be provider on leg " <> leg.legId)
      (alloc.allocator == leg.provider)

    -- Amount: pledged quantity must equal agreed quantity.
    assertMsg
      ("allocation match failed: amount mismatch on leg " <> leg.legId)
      (alloc.amount == leg.amount)

    -- Instrument / asset id: allocated instrument must equal agreed instrumentId.
    assertMsg
      ("allocation match failed: instrumentId mismatch on leg " <> leg.legId)
      (alloc.instrumentId == leg.instrumentId)

    -- Reference: allocation must carry the same trade/leg reference.
    assertMsg
      ("allocation match failed: reference mismatch on leg " <> leg.legId)
      (alloc.reference == leg.reference)

    -- Deadline (agreed term): allocation deadline must equal the trade deadline.
    assertMsg
      ("allocation match failed: deadline mismatch on leg " <> leg.legId)
      (alloc.deadline == leg.deadline)

    -- Deadline (wall-clock): settlement after the agreed deadline is rejected.
    assertMsg
      ("allocation match failed: settlement past deadline on leg " <> leg.legId)
      (now <= leg.deadline)

    -- Bound asset: allocation must pledge the exact agreed asset contract.
    assertMsg
      ("allocation match failed: assetCid mismatch on leg " <> leg.legId)
      (alloc.assetCid == leg.assetCid)

    -- Live asset view: fetch pledged holding and re-check owner/instrument/amount.
    asset <- fetch alloc.assetCid
    let v = view asset
    assertMsg
      ("allocation match failed: live asset owner != provider on leg " <> leg.legId)
      (v.owner == leg.provider)
    assertMsg
      ("allocation match failed: live asset instrumentId mismatch on leg " <> leg.legId)
      (v.instrumentId == leg.instrumentId)
    assertMsg
      ("allocation match failed: live asset amount mismatch on leg " <> leg.legId)
      (v.amount == leg.amount)

-- | Resolve allocation CIDs to payloads; require exactly one allocation per legId.
fetchAllocationsByLeg :
    [LegSpec] -> [ContractId LegAllocation]
    -> Update [(LegSpec, ContractId LegAllocation, LegAllocation)]
fetchAllocationsByLeg legs allocationCids = do
    -- Completeness: every leg must have a posted allocation (rejects partial allocation).
    assertMsg
      ("allocation match failed: expected " <> show (length legs) <>
        " allocations, got " <> show (length allocationCids))
      (length allocationCids == length legs)
    pairs <- forA allocationCids $ \cid -> do
      a <- fetch cid
      pure (cid, a)
    forA legs $ \leg ->
      case find (\(_, a) -> a.legId == leg.legId) pairs of
        None -> do
          assertMsg
            ("allocation match failed: no allocation posted for leg " <> leg.legId)
            False
          -- Unreachable after assert; keeps the type-checker happy.
          error ("missing allocation for " <> leg.legId)
        Some (cid, alloc) ->
          pure (leg, cid, alloc)

-- | Co-signed agreement. Settle matches allocations then runs every Transfer
-- in one transaction (all-or-none).
template WorkflowAgreement
  with
    operator : Party
    parties : Set Party
    legs : [LegSpec]
    description : Text
    acceptedBy : Set Party
    governanceRequired : Bool
  where
    signatory operator
    observer Set.toList parties
    ensure length legs >= 2

    -- | Explicitly enables BitSafe governance control on this agreement.
    -- Once called, direct Settle choices are locked and settlement must run via GovernedSettlement.
    choice RequireGovernance : ContractId WorkflowAgreement
      controller operator
      do
        create this with governanceRequired = True

    -- | Provider posts a pledge that Settle will match field-by-field.
    -- Note on asset locking: LegAllocation binds assetCid with wall-clock deadline,
    -- instrument, and amount verification. If a provider transfers the holding away
    -- prior to settlement, matchAllocationToLeg fails and reverts cleanly (R-ATOM-2).
    nonconsuming choice AllocateLeg : ContractId LegAllocation
      with
        allocator : Party
        legId : Text
        instrumentId : Text
        amount : Decimal
        provider : Party
        receiver : Party
        assetCid : ContractId ComposableAsset
        reference : Text
        deadline : Time
      controller operator, allocator
      do
        assertMsg "allocator must be a settlement party" (Set.member allocator parties)
        assertMsg "allocator must be the provider" (allocator == provider)
        assertMsg "legId must exist on agreement" (any (\l -> l.legId == legId) legs)
        create LegAllocation with
          operator
          agreementCid = self
          allocator
          legId
          instrumentId
          amount
          provider
          receiver
          assetCid
          reference
          deadline

    choice Settle : ContractId SettlementReceipt
      with
        allocationCids : [ContractId LegAllocation]
      controller operator, Set.toList parties
      do
        assertMsg "governed settlement required: must execute via GovernedSettlement"
          (not governanceRequired)
        now <- getTime
        matched <- fetchAllocationsByLeg legs allocationCids
        -- R-ALLOC: every allocation must match agreed terms before any Transfer.
        forA_ matched $ \(leg, _allocCid, alloc) -> do
          assertMsg
            ("allocation match failed: allocation not bound to this agreement on leg " <>
              leg.legId)
            (alloc.agreementCid == self)
          matchAllocationToLeg now leg alloc
        -- R-ATOM-1/2: consume pledges then Transfer; any failure aborts all.
        forA_ matched $ \(leg, allocCid, _alloc) -> do
          archive allocCid
          exercise leg.assetCid Transfer with newOwner = leg.receiver
        let summaries = map (\l -> LegSummary with
              legId = l.legId
              instrumentId = l.instrumentId
              status = LegSettled) legs
        create SettlementReceipt with
          operator
          participants = parties
          settledAt = now
          description
          legSummaries = summaries
          regulators = Set.empty

    choice SettleWithRegulator : ContractId SettlementReceipt
      with
        regulator : Party
        allocationCids : [ContractId LegAllocation]
      controller operator, Set.toList parties
      do
        assertMsg "governed settlement required: must execute via GovernedSettlement"
          (not governanceRequired)
        now <- getTime
        matched <- fetchAllocationsByLeg legs allocationCids
        forA_ matched $ \(leg, _allocCid, alloc) -> do
          assertMsg
            ("allocation match failed: allocation not bound to this agreement on leg " <>
              leg.legId)
            (alloc.agreementCid == self)
          matchAllocationToLeg now leg alloc
        forA_ matched $ \(leg, allocCid, _alloc) -> do
          archive allocCid
          exercise leg.assetCid Transfer with newOwner = leg.receiver
        let summaries = map (\l -> LegSummary with
              legId = l.legId
              instrumentId = l.instrumentId
              status = LegSettled) legs
        create SettlementReceipt with
          operator
          participants = parties
          settledAt = now
          description
          legSummaries = summaries
          regulators = Set.fromList [regulator]

    -- | Governed settlement execution choice, verified and called exclusively by GovernedSettlement
    choice SettleGoverned : ContractId SettlementReceipt
      with
        governorApprovers : Set Party
        threshold : Int
        regulator : Optional Party
        allocationCids : [ContractId LegAllocation]
      controller operator, Set.toList parties
      do
        assertMsg "governance threshold not met" (Set.size governorApprovers >= threshold)
        now <- getTime
        matched <- fetchAllocationsByLeg legs allocationCids
        forA_ matched $ \(leg, _allocCid, alloc) -> do
          assertMsg
            ("allocation match failed: allocation not bound to this agreement on leg " <>
              leg.legId)
            (alloc.agreementCid == self)
          matchAllocationToLeg now leg alloc
        forA_ matched $ \(leg, allocCid, _alloc) -> do
          archive allocCid
          exercise leg.assetCid Transfer with newOwner = leg.receiver
        let summaries = map (\l -> LegSummary with
              legId = l.legId
              instrumentId = l.instrumentId
              status = LegSettled) legs
        create SettlementReceipt with
          operator
          participants = parties
          settledAt = now
          description
          legSummaries = summaries
          regulators = case regulator of
            None -> Set.empty
            Some reg -> Set.fromList [reg]

    choice CancelAgreement : ()
      with
        reason : Text
      controller operator
      do
        pure ()

-- | Proof settlement occurred.
-- signatory: operator
-- observers: participants + regulator(s)
-- Scoped: only blinded LegSummary (id/instrument/status) — NOT assetCid or amounts.
template SettlementReceipt
  with
    operator : Party
    participants : Set Party
    settledAt : Time
    description : Text
    legSummaries : [LegSummary]
    regulators : Set Party
  where
    signatory operator
    observer (Set.toList participants ++ Set.toList regulators)
