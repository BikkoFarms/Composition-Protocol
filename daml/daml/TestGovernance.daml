-- | BitSafe LocalNet demos: below-threshold reject, at-threshold accept/cancel.
--
-- Named controllers: Gov1, Gov2, Gov3 (BitSafe contribution pool).
-- Threshold: 2-of-3 — ExecuteGoverned / CancelGoverned require two distinct
-- governor approvals before the operator may complete the governed action.
--
-- Reproduce on LocalNet:
--   cd daml && daml test --test-pattern testGoverned
--   (or full: daml test)
-- See docs/DAML_SETUP.md § BitSafe M-of-N.
module TestGovernance where

import Composition
import Governance
import MockToken
import Daml.Script
import qualified DA.Set as Set
import DA.Date (datetime, Month(..))
import ComposableAsset ()

farDeadline : Time
farDeadline = datetime 2099 Jan 1 0 0 0

setupSwap :
  Script (Party, Party, Party, Party, ContractId WorkflowAgreement, [LegSpec])
setupSwap = do
  operator <- allocateParty "Operator"
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  regulator <- allocateParty "Regulator"
  aliceUsd <- submit operator do
    createCmd MockToken with
      owner = alice
      issuer = operator
      instrumentId = "USDCx"
      amount = 100.0
  bobCbtc <- submit operator do
    createCmd MockToken with
      owner = bob
      issuer = operator
      instrumentId = "CBTC"
      amount = 1.0
  let legs =
        [ LegSpec with
            legId = "cash"
            instrumentId = "USDCx"
            amount = 100.0
            provider = alice
            receiver = bob
            assetCid = toInterfaceContractId aliceUsd
            reference = "gov-cash"
            deadline = farDeadline
        , LegSpec with
            legId = "collateral"
            instrumentId = "CBTC"
            amount = 1.0
            provider = bob
            receiver = alice
            assetCid = toInterfaceContractId bobCbtc
            reference = "gov-cbtc"
            deadline = farDeadline
        ]
  proposalCid <- submitMulti [operator, alice] [bob] do
    createCmd WorkflowProposal with
      operator
      proposer = alice
      counterparties = [bob]
      legs
      description = "gov demo"
      expiresAt = farDeadline
  trackerCid <- submitMulti [operator, bob] [] do
    exerciseCmd proposalCid AcceptProposal with
      acceptor = bob
      trackerCid = None
  agreementCid <- submit operator do
    exerciseCmd trackerCid FinalizeAgreement
  pure (operator, alice, bob, regulator, agreementCid, legs)

allocateFromLeg :
  Party -> ContractId WorkflowAgreement -> LegSpec ->
  Script (ContractId LegAllocation)
allocateFromLeg operator agreementCid leg =
  submitMulti [operator, leg.provider] [] do
    exerciseCmd agreementCid AllocateLeg with
      allocator = leg.provider
      legId = leg.legId
      instrumentId = leg.instrumentId
      amount = leg.amount
      provider = leg.provider
      receiver = leg.receiver
      assetCid = leg.assetCid
      reference = leg.reference
      deadline = leg.deadline

-- | R-GOV-1 failure: Execute below threshold must fail.
-- Controllers: Gov1, Gov2, Gov3. Threshold = 2.
-- Only Gov1 has approved → |approvals| = 1 < 2 → reject; no settlement.
testGovernedBelowThreshold : Script ()
testGovernedBelowThreshold = do
  (operator, alice, bob, regulator, agreementCid, _legs) <- setupSwap
  g1 <- allocateParty "Gov1"
  g2 <- allocateParty "Gov2"
  g3 <- allocateParty "Gov3"
  factory <- submit operator do
    createCmd GovernanceFactory with operator
  govCid <- submit operator do
    exerciseCmd factory OpenGovernedSettlement with
      agreementCid
      governors = [g1, g2, g3]
      threshold = 2
      regulator
  govCid2 <- submitMulti [operator, g1] [] do
    exerciseCmd govCid ApproveGoverned with governor = g1
  submitMultiMustFail [operator, alice, bob] [] do
    exerciseCmd govCid2 ExecuteGoverned with allocationCids = []
  pure ()

-- | R-GOV-1 success: at threshold Execute succeeds.
-- Controllers: Gov1, Gov2, Gov3. Threshold = 2.
-- Gov1 + Gov2 approve → |approvals| = 2 ≥ 2 → SettleWithRegulator commits.
testGovernedAtThreshold : Script ()
testGovernedAtThreshold = do
  (operator, alice, bob, regulator, agreementCid, legs) <- setupSwap
  g1 <- allocateParty "Gov1"
  g2 <- allocateParty "Gov2"
  g3 <- allocateParty "Gov3"
  factory <- submit operator do
    createCmd GovernanceFactory with operator
  govCid <- submit operator do
    exerciseCmd factory OpenGovernedSettlement with
      agreementCid
      governors = [g1, g2, g3]
      threshold = 2
      regulator
  gov1 <- submitMulti [operator, g1] [] do
    exerciseCmd govCid ApproveGoverned with governor = g1
  gov2 <- submitMulti [operator, g2] [] do
    exerciseCmd gov1 ApproveGoverned with governor = g2
  allocs <- mapA (allocateFromLeg operator agreementCid) legs
  receiptCid <- submitMulti [operator, alice, bob] [] do
    exerciseCmd gov2 ExecuteGoverned with allocationCids = allocs
  Some _ <- queryContractId operator receiptCid
  pure ()

-- | R-GOV-2 failure: Cancel below threshold must fail.
-- Controllers: Gov1, Gov2, Gov3. Threshold = 2. Only Gov1 cancel-approved.
testGovernedCancelBelowThreshold : Script ()
testGovernedCancelBelowThreshold = do
  (operator, _alice, _bob, regulator, agreementCid, _legs) <- setupSwap
  g1 <- allocateParty "Gov1"
  g2 <- allocateParty "Gov2"
  g3 <- allocateParty "Gov3"
  factory <- submit operator do
    createCmd GovernanceFactory with operator
  govCid <- submit operator do
    exerciseCmd factory OpenGovernedSettlement with
      agreementCid
      governors = [g1, g2, g3]
      threshold = 2
      regulator
  gov1 <- submitMulti [operator, g1] [] do
    exerciseCmd govCid ApproveCancelGoverned with governor = g1
  submitMustFail operator do
    exerciseCmd gov1 CancelGoverned with reason = "too early"
  Some _agr <- queryContractId operator agreementCid
  pure ()

-- | R-GOV-2 success: Cancel at threshold archives the agreement cleanly.
-- Controllers: Gov1, Gov2, Gov3. Threshold = 2. Gov1 + Gov2 cancel-approve.
testGovernedCancelAtThreshold : Script ()
testGovernedCancelAtThreshold = do
  (operator, _alice, _bob, regulator, agreementCid, _legs) <- setupSwap
  g1 <- allocateParty "Gov1"
  g2 <- allocateParty "Gov2"
  g3 <- allocateParty "Gov3"
  factory <- submit operator do
    createCmd GovernanceFactory with operator
  govCid <- submit operator do
    exerciseCmd factory OpenGovernedSettlement with
      agreementCid
      governors = [g1, g2, g3]
      threshold = 2
      regulator
  c1 <- submitMulti [operator, g1] [] do
    exerciseCmd govCid ApproveCancelGoverned with governor = g1
  c2 <- submitMulti [operator, g2] [] do
    exerciseCmd c1 ApproveCancelGoverned with governor = g2
  submit operator do
    exerciseCmd c2 CancelGoverned with reason = "pool consensus cancel"
  None <- queryContractId operator agreementCid
  pure ()

-- | Institutional Safety: Emergency Veto by authorized governor
-- Veto archives the underlying agreement so it cannot be settled.
testEmergencyVeto : Script ()
testEmergencyVeto = do
  (operator, _alice, _bob, regulator, agreementCid, _legs) <- setupSwap
  g1 <- allocateParty "Gov1"
  g2 <- allocateParty "Gov2"
  factory <- submit operator do
    createCmd GovernanceFactory with operator
  govCid <- submit operator do
    exerciseCmd factory OpenGovernedSettlement with
      agreementCid
      governors = [g1, g2]
      threshold = 2
      regulator
  submitMulti [operator, g1] [] do
    exerciseCmd govCid EmergencyVeto with
      governor = g1
      reason = "Malicious counterparty detected"
  -- Verify agreement is archived and no longer live on ledger
  None <- queryContractId operator agreementCid
  pure ()

-- | Institutional Safety: Circuit Breaker emergency halt and resume
testCircuitBreaker : Script ()
testCircuitBreaker = do
  operator <- allocateParty "Operator"
  g1 <- allocateParty "Gov1"
  cbCid <- submit operator do
    createCmd ProtocolCircuitBreaker with
      operator
      governors = Set.fromList [g1]
      isHalted = False
      haltReason = None
  cbHaltedCid <- submitMulti [operator, g1] [] do
    exerciseCmd cbCid TriggerEmergencyHalt with
      governor = g1
      reason = "Oracle anomaly"
  Some halted <- queryContractId operator cbHaltedCid
  assertMsg "circuit breaker must be active" halted.isHalted
  cbResumedCid <- submitMulti [operator, g1] [] do
    exerciseCmd cbHaltedCid ResumeProtocol with
      governor = g1
  Some resumed <- queryContractId operator cbResumedCid
  assertMsg "circuit breaker must be resumed" (not resumed.isHalted)
  pure ()
