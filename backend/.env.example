# Demo mode (default)
PORT=4000

# Live Canton Ledger Mode (set to 'ledger' to activate Canton JSON Ledger API v2)
# LEDGER_MODE=ledger

# Shared HackCanton DevNet (submission target)
# LEDGER_API_URL=https://ledger-api-json.participant.hackcanton-01.devnet.naas.noders.services
# LEDGER_API_TOKEN=
# DAML_PACKAGE_ID=
# DAML_PACKAGE_NAME=composition

# Keycloak OIDC Token Authentication (if LEDGER_API_TOKEN is not directly set)
# OIDC_TOKEN_URL=https://keycloak.naas.noders.services/realms/noders-appsfactory/protocol/openid-connect/token
# OIDC_AUDIENCE=https://hackcanton-01.devnet.naas.noders.services
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_USERNAME=
# OIDC_PASSWORD=

# LocalNet Canton JSON API
# LEDGER_API_URL=http://localhost:7575

