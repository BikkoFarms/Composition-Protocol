# =============================================================================
# SettleFlow (Composition Protocol) — Production Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# 1. FRONTEND SERVICE (Next.js 15)
# -----------------------------------------------------------------------------
# Public HTTPS URL of the deployed Backend API Gateway:
NEXT_PUBLIC_API_URL=https://settleflow-backend-zcp7.onrender.com

# Public HTTPS URL of the deployed Commodity Oracle Service:
NEXT_PUBLIC_ORACLE_URL=https://settleflow-oracle.onrender.com

# Node runtime version:
NODE_VERSION=22

# -----------------------------------------------------------------------------
# 2. BACKEND API GATEWAY (Node.js / Express)
# -----------------------------------------------------------------------------
# Port assigned automatically by cloud host (Render sets PORT=10000):
PORT=4000

# Execution mode: 'demo' (in-memory Canton simulation) or 'ledger' (live node)
LEDGER_MODE=demo

# Public HTTPS URL of the Oracle Microservice for commodity pricing
ORACLE_URL=https://settleflow-oracle.onrender.com

# Live Canton JSON Ledger API v2 (optional — required only if LEDGER_MODE=ledger):
# LEDGER_API_URL=https://ledger-api-json.participant.hackcanton-01.devnet.naas.noders.services
# LEDGER_API_TOKEN=eyJh...
# DAML_PACKAGE_ID=
# DAML_PACKAGE_NAME=composition

# Keycloak OIDC Authentication for shared HackCanton DevNet (optional):
# OIDC_TOKEN_URL=https://keycloak.naas.noders.services/realms/noders-appsfactory/protocol/openid-connect/token
# OIDC_AUDIENCE=https://hackcanton-01.devnet.naas.noders.services
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_USERNAME=
# OIDC_PASSWORD=

# -----------------------------------------------------------------------------
# 3. COMMODITY ORACLE SERVICE (mocks/oracle/server.mjs)
# -----------------------------------------------------------------------------
# Port assigned automatically by cloud host:
PORT=4002

# Secret key for HMAC-SHA256 warehouse quality inspection certificate signatures:
ORACLE_SIGNING_KEY=canton-oracle-secp256k1-secret-key-prod
