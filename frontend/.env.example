# SettleFlow Frontend Environment Variables

# Backend API Gateway URL (defaults to http://localhost:4000 locally)
# In production on Render: https://settleflow-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: Commodity Oracle Microservice URL (defaults to http://localhost:4002)
# In production on Render: https://settleflow-oracle.onrender.com
NEXT_PUBLIC_ORACLE_URL=http://localhost:4002
